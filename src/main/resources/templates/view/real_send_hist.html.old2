									</div>
									<div class="processFileStat">
										<div>DB</div>
										<span class="statColor red"></span>
									</div>
								</div>
							</div>
						</div>
					</div>							
				</div>
			`;
			gmarket.appendChild(li);
		}

		const auction = document.querySelector('ul.auction');
		for(let i=0; i<22; i++){
			const li = document.createElement('li');
			li.classList.add('col');
			li.innerHTML = `
				<div class="card">
					<div class="card-body d-flex align-items-center justify-content-between">	
						<div class="serviceName text-nowrap font-weight-600">KT-SMS-STATP-GMA-2CON</div>
						<div class="processFiles d-flex gap-1">
							<div class="processFile gap-2">
								<div class="processFileName">DBP</div>
								<div class="processFileStatWrap">
									<div class="processFileStat">
										<div>PS</div>
										<span class="statColor"></span>
									</div>
									<div class="processFileStat">
										<div>DB</div>
										<span class="statColor red"></span>
									</div>
								</div>
							</div>
							<div class="processFile gap-2">
								<div class="processFileName">IFP01</div>
								<div class="processFileStatWrap">
									<div class="processFileStat">
										<div>PS</div>
										<span class="statColor green"></span>
									</div>
									<div class="processFileStat">
										<div>DB</div>
										<span class="statColor green"></span>
									</div>
								</div>
							</div>
							<div class="processFile gap-2">
								<div class="processFileName">MEMMON</div>
								<div class="processFileStatWrap">
									<div class="processFileStat">
										<div>PS</div>
										<span class="statColor green"></span>
									</div>
									<div class="processFileStat">
										<div>DB</div>
										<span class="statColor red"></span>
									</div>
								</div>
							</div>
						</div>
					</div>							
				</div>
			`;
			auction.appendChild(li);
		}

		const smileCash = document.querySelector('ul.smileCash');
		for(let i=0; i<4; i++){
			const li = document.createElement('li');
			li.classList.add('col');
			li.innerHTML = `
				<div class="card">
					<div class="card-body d-flex align-items-center justify-content-between">	
						<div class="serviceName text-nowrap font-weight-600">KT-SMS-STATP-GMA-2CON</div>
						<div class="processFiles d-flex gap-1">
							<div class="processFile gap-2">
								<div class="processFileName">DBP</div>
								<div class="processFileStatWrap">
									<div class="processFileStat">
										<div>PS</div>
										<span class="statColor"></span>
									</div>
									<div class="processFileStat">
										<div>DB</div>
										<span class="statColor red"></span>
									</div>
								</div>
							</div>
							<div class="processFile gap-2">
								<div class="processFileName">IFP01</div>
								<div class="processFileStatWrap">
									<div class="processFileStat">
										<div>PS</div>
										<span class="statColor green"></span>
									</div>
									<div class="processFileStat">
										<div>DB</div>
										<span class="statColor green"></span>
									</div>
								</div>
							</div>
							<div class="processFile gap-2">
								<div class="processFileName">MEMMON</div>
								<div class="processFileStatWrap">
									<div class="processFileStat">
										<div>PS</div>
										<span class="statColor green"></span>
									</div>
									<div class="processFileStat">
										<div>DB</div>
										<span class="statColor red"></span>
									</div>
								</div>
							</div>
						</div>
					</div>							
				</div>
			`;
			smileCash.appendChild(li);
		}
	};
</script>